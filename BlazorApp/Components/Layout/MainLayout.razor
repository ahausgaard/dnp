@inherits LayoutComponentBase
@using BlazorApp.Components.Dialogs
@using BlazorApp.Auth
@inject IDialogService DialogService
@inject SimpleAuthProvider AuthProvider
<MudThemeProvider/>
<MudPopoverProvider/>
@* All dialogs: up to 600px wide (MaxWidth.Small), filling that width instead of shrinking to their content. *@
<MudDialogProvider MaxWidth="MaxWidth.Small" FullWidth="true"/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar>
        <SectionOutlet SectionName="page-title"/>
        <MudSpacer/>
        <AuthorizeView>
            <Authorized>
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2"/>
                <MudText>@context.User.Identity?.Name</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Logout"
                           OnClick="AuthProvider.Logout" Class="ml-4">Log out</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Login"
                           OnClick="OpenLoginDialog">Log in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer Color="Color.Secondary" Open="true" Fixed="true" Elevation="1">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Violit</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Home"
                        IconColor="Color.Inherit">Home
            </MudNavLink>
            <MudNavLink Href="/Users" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.People"
                        IconColor="Color.Inherit">Users
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>



    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task OpenLoginDialog()
    {
        await DialogService.ShowAsync<LoginDialog>("Log in");
    }
}
