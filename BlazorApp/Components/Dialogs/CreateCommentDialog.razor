@using DTOs
@using BlazorApp.Services
@using System.Security.Claims
@inject ICommentService CommentService
@inject AuthenticationStateProvider AuthProvider

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">Commenting as <b>@userName</b></MudText>
        <MudTextField @bind-Value="body" Label="Write a comment…" Lines="4" AutoFocus="true" />

        @if (error is not null)
        {
            <MudText Color="Color.Error" Class="mt-3">@error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="CreateComment" Disabled="saving">Comment</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // Given to us by MudBlazor; used to close the dialog.
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    // The post being commented on; passed in by PostDetails when it opens the dialog.
    [Parameter] public int PostId { get; set; }

    private int? userId;
    private string? userName;
    private string body = "";
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        // The dialog is only reachable when logged in, so read who that is.
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal user = state.User;
        if (user.Identity is null || !user.Identity.IsAuthenticated)
        {
            error = "You must be logged in.";
            return;
        }

        userName = user.Identity.Name;
        userId = int.Parse(user.Claims.Single(c => c.Type == "Id").Value);
    }

    private async Task CreateComment()
    {
        if (userId is null || string.IsNullOrWhiteSpace(body))
        {
            error = "Write a comment.";
            return;
        }

        try
        {
            saving = true;
            error = null;
            CommentDto created = await CommentService.AddCommentAsync(
                new CreateCommentDto { Body = body, UserId = userId.Value, PostId = PostId });

            // Close and hand the new comment back to the PostDetails page.
            MudDialog.Close(DialogResult.Ok(created));
        }
        catch (Exception e)
        {
            // Stay open so the user can fix it.
            error = e.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
