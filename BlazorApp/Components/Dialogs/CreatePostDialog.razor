@using DTOs
@using BlazorApp.Services
@using System.Security.Claims
@inject IPostService PostService
@inject AuthenticationStateProvider AuthProvider

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">Posting as <b>@userName</b></MudText>
        <MudTextField @bind-Value="title" Label="Title" AutoFocus="true" />
        <MudTextField @bind-Value="body" Label="Body" Lines="6" />

        @if (error is not null)
        {
            <MudText Color="Color.Error" Class="mt-3">@error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="CreatePost" Disabled="saving">Create post</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // Given to us by MudBlazor; used to close the dialog.
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private int? userId;
    private string? userName;
    private string title = "";
    private string body = "";
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        // The dialog is only reachable when logged in, so read who that is.
        AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal user = state.User;
        if (user.Identity is null || !user.Identity.IsAuthenticated)
        {
            error = "You must be logged in.";
            return;
        }

        userName = user.Identity.Name;
        userId = int.Parse(user.Claims.Single(c => c.Type == "Id").Value);
    }

    private async Task CreatePost()
    {
        if (userId is null || string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(body))
        {
            error = "Fill in both title and body.";
            return;
        }

        try
        {
            saving = true;
            error = null;
            PostDto created = await PostService.AddPostAsync(
                new CreatePostDto { Title = title, Body = body, UserId = userId.Value });

            // Close and hand the new post back to the Home page.
            MudDialog.Close(DialogResult.Ok(created));
        }
        catch (Exception e)
        {
            // Stay open so the user can fix it.
            error = e.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
