@page "/"
@using DTOs
@using BlazorApp.Services
@using BlazorApp.Components.Dialogs
@inject IPostService PostService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Violit</PageTitle>

<SectionContent SectionName="page-title">Home</SectionContent>

<AuthorizeView>
    <Authorized>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Message"
                   OnClick="OpenCreatePostDialog" Class="mb-4">Add post</MudButton>
    </Authorized>
</AuthorizeView>

@if (error is not null)
{
    <p style="color:red">@error</p>
}
else if (posts is null)
{
    <p>Loading...</p>
}
else if (posts.Count == 0)
{
    <p>No posts yet.</p>
}
else
{
    <MudStack Spacing="6">
        @foreach (var post in posts)
        {
            <div>
                <MudText><a href="Posts/@post.Id">@post.Title</a></MudText>
                <small><a href="Users/@post.Author?.Id">by @post.Author?.UserName</a></small>
            </div>
        }
    </MudStack>
}

@code {
    private List<PostDto>? posts;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            posts = await PostService.GetPostsAsync();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }
    
    private async Task OpenCreatePostDialog()
    {
        var dialog = await DialogService.ShowAsync<CreatePostDialog>("Create post");
        DialogResult? result = await dialog.Result;
        
        // Cancelled, or closed without a post: nothing to do.
        if (result is not { Canceled: false, Data: PostDto newPost })
            return;

        posts?.Add(newPost);
        Snackbar.Add($"Post \"{newPost.Title}\" created", Severity.Success);
    }
}
