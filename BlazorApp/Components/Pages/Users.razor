@page "/Users"
@using DTOs
@using BlazorApp.Services
@using BlazorApp.Components.Dialogs
@inject IUserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
<SectionContent SectionName="page-title">Users</SectionContent>

<MudButton Variant="Variant.Filled" Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.PersonAdd"
           OnClick="OpenAddUserDialog" Class="mb-4">Add user</MudButton>

@if (error is not null)
{
    <p style="color:red">@error</p>
}
else if (users is null)
{
    <p>Loading...</p>
}
else if (users.Count == 0)
{
    <p>No users yet.</p>
}
else
{   
    <MudText>Users</MudText>
    @foreach (var user in users)
    {
        <div>
        <MudText><a href="Users/@user.Id">@user.Id | @user.UserName</a></MudText>
        </div>
    }
}

@code {
    private List<UserDto>? users;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            users = await UserService.GetUsersAsync();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task OpenAddUserDialog()
    {
        var dialog = await DialogService.ShowAsync<AddUserDialog>("Add user");
        DialogResult? result = await dialog.Result;
        
        if (result is not { Canceled: false, Data: UserDto newUser })
            return;

        users?.Add(newUser);
        Snackbar.Add($"User {newUser.UserName} created", Severity.Success);
    }
}