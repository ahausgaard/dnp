@page "/Users/{UserId:int}"
@using DTOs
@using BlazorApp.Services
@inject IPostService PostService

@inject IUserService UserService

<SectionContent SectionName="page-title">@(user?.UserName ?? "User")</SectionContent>

@if (error is not null)
{
    <p style="color:red">@error</p>
}
else if (posts is null)
{
    <p>Loading...</p>
}
else if (posts.Count == 0)
{
    <p>No posts yet.</p>
}
else
{
    <MudStack Spacing="6">
        @foreach (var post in posts)
        {
            <div>
                <MudText><a href="Posts/@post.Id">@post.Title</a></MudText>
                <small><a href="Users/@post.Author?.Id">by @post.Author?.UserName</a></small>
            </div>
        }
    </MudStack>
}


@code {
    // Filled from {UserId} in the address, e.g. /Users/2 → 2.
    [Parameter] public int UserId { get; set; }
    private UserDto? user;
    private string? error;
    private List<PostDto>? posts;
    
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            error = null;
            user = await UserService.GetUserAsync(UserId);
            posts = await PostService.GetPostsAsync(UserId);
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }
}
