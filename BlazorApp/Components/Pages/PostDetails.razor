@page "/Posts/{PostId:int}"
@using DTOs
@using BlazorApp.Services
@using BlazorApp.Components.Dialogs
@inject IPostService PostService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<SectionContent
    SectionName="page-title">@(post?.Title ?? "Post")</SectionContent>

@if (error is not null)
{
    <p style="color:red">@error</p>
}
else if (post is null)
{
    <p>Loading...</p>
}
else
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        <i><a href="Users/@post.Author?.Id">@post.Author?.UserName</a> wrote:</i>
    </MudText>

    <MudText Typo="Typo.body1" Class="mt-2" Style="white-space: pre-line">@post.Body</MudText>
    <MudDivider Class="my-6"/>

    <MudText Typo="Typo.h6" Class="mb-3">Comments</MudText>

    @if (comments.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mb-4">No comments yet.</MudText>
    }

    @foreach (var comment in comments.OrderBy(c => c.Id))
    {
        <div class="mb-4">
            <MudText Typo="Typo.body2">@comment.Body</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">by @comment.Author?.UserName</MudText>
        </div>
    }

    <AuthorizeView>
        <Authorized>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddComment"
                       OnClick="OpenCreateCommentDialog" Class="mt-2">Add comment</MudButton>
        </Authorized>
    </AuthorizeView>
}

@code {
    [Parameter] public int PostId { get; set; }

    private PostDto? post;
    private List<CommentDto> comments = [];
    private string? error;

    // OnParametersSetAsync (not OnInitializedAsync) so it reloads if you
    // navigate from one post straight to another.
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            error = null;
            post = await PostService.GetPostAsync(PostId);
            comments = post.Comments ?? [];
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private async Task OpenCreateCommentDialog()
    {
        // Tell the dialog which post the comment belongs to.
        var parameters = new DialogParameters<CreateCommentDialog>
        {
            { d => d.PostId, PostId }
        };
        var dialog = await DialogService.ShowAsync<CreateCommentDialog>("Add comment", parameters);
        DialogResult? result = await dialog.Result;

        // Cancelled, or closed without a comment: nothing to do.
        if (result is not { Canceled: false, Data: CommentDto newComment })
            return;

        comments.Add(newComment);
        Snackbar.Add("Comment added", Severity.Success);
    }
}
